# Copia este archivo a deploy/.env en el servidor y rellénalo.
# Genera cada secreto con:  openssl rand -hex 32

# Dominio público (sin https://). Debe apuntar (registro A) a la IP de la VM.
DOMAIN=fraguago.tu-dominio.com

# ---- Postgres ----
POSTGRES_DB=fraguago
POSTGRES_PASSWORD=cambia_esto          # superusuario "postgres" (solo admin/backups)
APP_DB_PASSWORD=cambia_esto            # rol "fraguago" (API, con RLS)
AUTH_DB_PASSWORD=cambia_esto           # rol "fraguago_auth" (login/registro)
BACKUP_KEEP_DAYS=14

# ---- JWT ----
JWT_ACCESS_SECRET=cambia_esto
JWT_REFRESH_SECRET=cambia_esto
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

# ---- Web ----
NEXT_PUBLIC_ENABLE_REGISTRATION=false

# ---- Job diario de retención ----
RETENTION_CRON_TZ=America/Caracas
RETENTION_CRON_ENABLED=true

# ---- Opcionales ----
# Email (SMTP). Sin SMTP_HOST los envíos quedan como SKIPPED.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FraguaGo <no-reply@tu-dominio.com>"

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=58

# IA (rutinas / OCR de comprobantes)
GEMINI_API_KEY=
# Descomentar solo para cambiar el modelo (vacío rompe la IA; por defecto gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# PostHog (API y web usan la misma Project API key)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
