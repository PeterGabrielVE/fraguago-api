// =====================================================================
// Prisma schema — FraguaGo (multi-tenant gym SaaS)
// =====================================================================
//
// Golden rule:
// Every business table has gymId.
// Tenant isolation is enforced by NestJS.
// Every query must be scoped by gymId.
//
// Architecture:
//   User              -> Authentication + authorization
//   Profile           -> Personal information
//   Member            -> Gym customer / client
//   EmergencyContact  -> Emergency contact information
//   MedicalProfile    -> Medical and physical condition
//   Trainer           -> Trainer-specific information
//   MembershipPlan    -> Membership plan definition
//   Membership        -> Member's active/historical membership
//   Attendance        -> Daily gym access / attendance
//   Transaction       -> Financial transactions
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  OWNER
  ADMIN
  TRAINER
  STAFF
  MEMBER
}

enum ConceptKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ActivityLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingShift {
  MORNING
  AFTERNOON
  NIGHT
}

enum TrainingGoal {
  MUSCLE_GAIN
  WEIGHT_LOSS
  GENERAL_WELLNESS
  PERFORMANCE_REHABILITATION
}

enum MembershipType {
  DAILY
  MONTHLY
  QUARTERLY
  ANNUAL
}

// Estado ADMINISTRATIVO de una membresía. "Vencida", "por vencer" y "por
// iniciar" NO se guardan: se derivan de startDate/endDate (así nunca quedan
// desactualizados sin un cron).
enum MembershipStatus {
  ACTIVE    // vigente según sus fechas
  SUSPENDED // congelada por el staff (lesión, viaje…): no permite check-in
  CANCELLED // anulada: no cuenta como membresía
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum AttendanceShift {
  MORNING
  AFTERNOON
  NIGHT
}

enum Currency {
  USD
  VES
  EUR
}

// Origen de un movimiento de puntos (ledger de gamificación).
enum PointsSource {
  MANUAL // otorgado/deducido a mano por el staff
  ATTENDANCE // check-in diario
  BADGE // bono por desbloquear una insignia
  REDEMPTION // canje de recompensa (negativo)
  REDEMPTION_REFUND // devolución por canje cancelado
  CHALLENGE // premio por completar un reto
  REFERRAL // premio del programa de referidos
}

// Canal por el que sale un mensaje (RET-B01).
enum MessageChannel {
  EMAIL
  WHATSAPP
}

// Evento que dispara un mensaje automático (RET-B02 / RET-B03).
enum AutomationTrigger {
  INACTIVITY          // socio con membresía vigente que dejó de venir
  MEMBERSHIP_EXPIRING // membresía que vence en los próximos N días
}

enum MessageStatus {
  SENT
  FAILED
  SKIPPED // canal no configurado o destinatario sin dato de contacto
}

enum ReferralStatus {
  PENDING  // registrado; el referido todavía no tiene membresía
  REWARDED // el referido activó su primera membresía y se pagó el premio
}

// Qué se importa desde Excel/CSV (MIG-B01).
enum ImportType {
  MEMBERS_PAYMENTS // socios + último pago (hoja "Control de Pagos")
  ATTENDANCE       // cuadrícula de asistencia diaria (Día 1..31)
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Qué mide el progreso de un reto (siempre dentro de su ventana de fechas).
enum ChallengeMetric {
  ATTENDANCE_COUNT    // check-ins totales
  ATTENDANCE_DAYS     // días distintos con asistencia
  ROUTINE_COMPLETIONS // rutinas marcadas como completadas
}

// Regla con la que se desbloquea automáticamente una insignia.
enum BadgeCriteria {
  MANUAL // solo la otorga el staff
  ATTENDANCE_COUNT // asistencias totales >= threshold
  LIFETIME_POINTS // puntos acumulados históricos >= threshold
}

enum RewardType {
  DISCOUNT_PERCENT // value = % de descuento (1-100)
  DISCOUNT_AMOUNT // value = monto fijo en la moneda base del gym
  PRODUCT
  SERVICE
  OTHER
}

enum RedemptionStatus {
  PENDING // canjeado por el socio, falta entregarlo/aplicarlo
  FULFILLED // entregado/aplicado por el staff
  CANCELLED // anulado: se devuelven puntos y stock
}

// =====================================================================
// TENANT / GYM
// =====================================================================

model Gym {
  id        String   @id @default(uuid())
  name      String
  // Moneda de referencia para reportes/totales; los pagos en otra moneda se
  // convierten a esta usando la tasa vigente al momento del pago.
  baseCurrency Currency @default(USD)
  createdAt DateTime @default(now())

  users    User[]
  profiles Profile[]
  members  Member[]

  plans       MembershipPlan[]
  memberships Membership[]

  routines Routine[]
  trainers Trainer[]

  concepts     Concept[]
  transactions Transaction[]

  services  Service[]
  schedules Schedule[]

  auditLogs   AuditLog[]
  attendances Attendance[]

  products Product[]
  sales     Sale[]  
  saleItems SaleItem[]
  stockMovements StockMovement[]
  measurements Measurement[]

  emergencyContacts EmergencyContact[]
  medicalProfiles   MedicalProfile[]

  exchangeRates ExchangeRate[]

  tiers              Tier[]
  pointsTransactions PointsTransaction[]
  badges             Badge[]
  memberBadges       MemberBadge[]
  rewards            Reward[]
  rewardRedemptions  RewardRedemption[]

  challenges            Challenge[]
  challengeParticipants ChallengeParticipant[]
  routineLogs           RoutineLog[]

  automatedMessages AutomatedMessage[]
  messageLogs       MessageLog[]
  referrals         Referral[]

  importJobs ImportJob[]

  exercises        Exercise[]
  routineExercises RoutineExercise[]

  @@index([name])
}

// =====================================================================
// USERS
// =====================================================================
//
// Represents an account that can authenticate into FraguaGo.
//
// OWNER   -> Gym owner
// ADMIN   -> Administrator
// TRAINER -> Trainer with system access
// STAFF   -> Reception/staff
// MEMBER  -> Gym customer with portal/app access
//
// Email is unique inside a gym, not globally.
// =====================================================================

model User {
  id    String @id @default(uuid())
  gymId String

  email        String
  passwordHash String
  role         Role

  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  profile   Profile?
  member    Member?
  trainer   Trainer?
  auditLogs AuditLog[]
  refreshTokens RefreshToken[]
  salesCreated  Sale[] @relation("SaleCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, email])
  @@index([gymId])
}

// =====================================================================
// REFRESH TOKENS
// =====================================================================
//
// Long-lived tokens used to obtain new access tokens without
// forcing the user to log in again.
//
// Security notes:
// - We NEVER store the raw token. Only its SHA-256 hash (tokenHash).
// - Rotation: on every /auth/refresh the current token is revoked
//   and a new one is issued.
// - `revoked` lets us implement real logout and "logout everywhere".
// - Reusing a revoked token is treated as theft (revoke all sessions).
//
// Not scoped by gymId on purpose: a refresh token is always resolved
// through userId (which already carries the tenant). It is auth
// infrastructure, not tenant business data, so it never takes part
// in gym-scoped queries. See note below if you want strict consistency.
// =====================================================================

model RefreshToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String   // SHA-256 of the raw refresh token — never the plain token
  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])   // el /auth/refresh busca por este hash
}

// =====================================================================
// PROFILE
// =====================================================================
//
// Personal information belonging to a User.
//
// Authentication data stays in User.
// Personal data stays here.
//
// Fields based on the registration form:
// - First name
// - Last name
// - Phone
// - Address
// =====================================================================

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  gymId  String

  firstName String
  lastName  String
  phone     String?
  address   String?
  preferredTime String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

// =====================================================================
// MEMBERS
// =====================================================================
//
// Gym customers.
//
// A Member has a User account because members can log in to:
// - View membership
// - View routines
// - View attendance
// - View measurements
// - View progress
//
// Personal information is stored in Profile.
// Member stores gym/customer-specific information.
// =====================================================================

model Member {
  id     String @id @default(uuid())
  gymId  String
  userId String @unique

  identificationNumber String
  birthDate            DateTime?

  activityLevel   ActivityLevel?
  preferredShift  TrainingShift?
  primaryGoal     TrainingGoal?
  goalDescription String?

  status MemberStatus @default(ACTIVE)

  // Gamificación: saldo canjeable y acumulado histórico (define el nivel).
  // Se mantienen desnormalizados; la fuente de verdad es PointsTransaction.
  pointsBalance  Int @default(0)
  lifetimePoints Int @default(0)

  // Programa de referidos: código que el socio comparte (único por gym).
  // Se genera la primera vez que el socio lo consulta.
  referralCode String?

  // Identificador del socio en el sistema anterior (p. ej. el "ID" 001 de la
  // planilla de Excel). Evita duplicados al reimportar y permite cruzar la
  // hoja de asistencia. Único por gym.
  externalId String?

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emergencyContact EmergencyContact?
  medicalProfile   MedicalProfile?

  memberships  Membership[]
  routines     Routine[]
  transactions Transaction[]
  attendances  Attendance[]
  sales      Sale[]
  measurements Measurement[]

  pointsTransactions PointsTransaction[]
  badges             MemberBadge[]
  rewardRedemptions  RewardRedemption[]

  challengeParticipations ChallengeParticipant[]
  routineLogs             RoutineLog[]

  messageLogs   MessageLog[]
  referralsMade Referral[]  @relation("ReferralReferrer")
  referredBy    Referral?   @relation("ReferralReferred")

  @@unique([gymId, identificationNumber])
  @@unique([gymId, referralCode])
  @@unique([gymId, externalId])
  @@index([gymId])
  @@index([userId])
}

// =====================================================================
// EMERGENCY CONTACT
// =====================================================================
//
// Based on registration form:
// - Contact name
// - Phone
// - Relationship
// =====================================================================

model EmergencyContact {
  id       String @id @default(uuid())
  gymId    String
  memberId String @unique

  name         String
  phone        String
  relationship String

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([memberId])
}

// =====================================================================
// MEDICAL PROFILE
// =====================================================================
//
// Based on the registration form.
//
// Health conditions:
// - Hypertension
// - Diabetes
// - Heart problems
// - Asthma
// - Other conditions
//
// Physical limitations:
// - Injury
// - Injury description
//
// Continuous medication:
// - Takes medication
// - Medication description
// =====================================================================

model MedicalProfile {
  id       String @id @default(uuid())
  gymId    String
  memberId String @unique

  hypertension  Boolean @default(false)
  diabetes      Boolean @default(false)
  heartProblems Boolean @default(false)
  asthma        Boolean @default(false)

  otherConditions String?

  hasInjury         Boolean @default(false)
  injuryDescription String?

  takesMedication       Boolean @default(false)
  medicationDescription String?

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([memberId])
}

// =====================================================================
// MEMBERSHIP PLANS
// =====================================================================
//
// Defines the plans offered by a gym.
//
// Examples:
// - Daily
// - Monthly
// - Quarterly
// - Annual
// =====================================================================

model MembershipPlan {
  id    String @id @default(uuid())
  gymId String

  name         String
  type         MembershipType
  price        Decimal        @db.Decimal(10, 2)
  currency     Currency       @default(USD)
  durationDays Int

  createdAt DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([gymId])
  @@index([gymId, type])
}

// =====================================================================
// MEMBERSHIPS
// =====================================================================
//
// Represents a membership purchased/assigned to a member.
// =====================================================================

model Membership {
  id       String @id @default(uuid())
  gymId    String
  memberId String
  planId   String

  startDate DateTime         @default(now())
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([planId])
}

// =====================================================================
// TRAINERS
// =====================================================================
//
// Trainer-specific business information.
//
// Authentication data is stored in User.
// Personal data is stored in Profile.
// Trainer stores only information specific to being a trainer.
// =====================================================================

model Trainer {
  id     String @id @default(uuid())
  gymId  String
  userId String @unique

  specialty             String?
  identificationNumber  String?

  createdAt DateTime @default(now())

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  routines  Routine[]
  schedules Schedule[]

  @@index([gymId])
  @@index([userId])
}

// =====================================================================
// ROUTINES
// =====================================================================

model Routine {
  id        String  @id @default(uuid())
  gymId     String
  memberId  String
  trainerId String?

  name        String
  description String?

  createdAt DateTime @default(now())

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  logs      RoutineLog[]
  exercises RoutineExercise[]

  @@index([gymId])
  @@index([memberId])
  @@index([trainerId])
}

// =====================================================================
// CONCEPTS
// =====================================================================
//
// Financial categories.
// =====================================================================

model Concept {
  id    String @id @default(uuid())
  gymId String

  name String
  kind ConceptKind

  createdAt DateTime @default(now())

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([gymId])
}

// =====================================================================
// FINANCIAL TRANSACTIONS
// =====================================================================
//
// Used for income and expenses.
//
// For membership payments, paymentMethod indicates:
// - Cash
// - Card
// - Transfer
// - Other
//
// createdById identifies the User who registered the transaction.
// =====================================================================

model Transaction {
  id    String @id @default(uuid())
  gymId String

  type      TransactionType
  conceptId String?
  memberId  String?

  amount        Decimal        @db.Decimal(10, 2)
  // Moneda en la que efectivamente se pagó/gastó, y la tasa usada para
  // convertirlo a la moneda base del gym en ese momento (snapshot, nunca
  // se recalcula después aunque cambie la tasa). amountBase = amount cuando
  // currency ya es la moneda base.
  currency      Currency       @default(USD)
  exchangeRate  Decimal        @db.Decimal(12, 6) @default(1)
  amountBase    Decimal        @db.Decimal(10, 2) @default(0)
  paymentMethod PaymentMethod?
  note          String?
  date          DateTime       @default(now())

  // DB-05 — venta POS que originó este ingreso (null = movimiento manual).
  saleId String? @unique

  createdById String?

  createdAt DateTime @default(now())

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  member  Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sale    Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([gymId, type])
  @@index([memberId])
  @@index([createdById])
}

// =====================================================================
// EXCHANGE RATES
// =====================================================================
//
// Tasa de cambio de una moneda (VES, EUR) respecto a la moneda base del
// gym, registrada manualmente por el staff (ej. "la tasa BCV de hoy").
// `rate` = cuántas unidades de `currency` equivalen a 1 unidad de la moneda
// base (ej. VES: 900 significa "900 Bs = 1 USD"), tal como el staff piensa
// la tasa del día. Se guarda un historial: cada pago referencia la tasa
// vigente en ese momento (ver Transaction.exchangeRate), nunca se recalcula.
// =====================================================================

model ExchangeRate {
  id    String @id @default(uuid())
  gymId String

  currency    Currency
  rate        Decimal  @db.Decimal(12, 6)
  source      String?
  effectiveAt DateTime @default(now())

  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, currency, effectiveAt])
}

// =====================================================================
// SERVICES
// =====================================================================

model Service {
  id    String @id @default(uuid())
  gymId String

  name        String
  price       Decimal  @db.Decimal(10, 2)
  currency    Currency @default(USD)
  description String?

  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

// =====================================================================
// SCHEDULES
// =====================================================================

model Schedule {
  id        String  @id @default(uuid())
  gymId     String
  trainerId String?

  title     String
  weekday   Int
  startTime String
  endTime   String
  capacity  Int?

  createdAt DateTime @default(now())

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([trainerId])
}

// =====================================================================
// AUDIT LOGS
// =====================================================================

model AuditLog {
  id     String  @id @default(uuid())
  gymId  String
  userId String?

  action   String
  entity   String
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  gym  Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([userId])
  @@index([gymId, createdAt])
}

// =====================================================================
// ATTENDANCE
// =====================================================================
//
// Daily attendance / access control.
//
// Based on the registration/attendance sheet:
// - Date
// - Shift
// - Entry time
// - Member
// - Pass type
// - Signature
//
// Member name and identification number are obtained through Member,
// Profile and User rather than duplicated here.
// =====================================================================

model Attendance {
  id       String @id @default(uuid())
  gymId    String
  memberId String

  checkedInAt DateTime        @default(now())
  shift       AttendanceShift
  passType    MembershipType?
  signature   String?

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, checkedInAt])
}

// =====================================================================
// PRODUCTS & INVENTORY
// =====================================================================

model Product {
  id    String @id @default(uuid())
  gymId String

  name     String
  price    Decimal  @db.Decimal(10, 2)
  currency Currency @default(USD)
  stock    Int      @default(0)
  sku      String?

  createdAt DateTime @default(now())

  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([gymId])
  @@index([gymId, sku])
}

// =====================================================================
// SALES / POS  (cabecera del ticket)
// =====================================================================

model Sale {
  id       String  @id @default(uuid())
  gymId    String
  memberId String?  // opcional: venta a un socio o a público general

  total Decimal @db.Decimal(10, 2) // suma de todos los items
  // Moneda de `total` (la de los productos: una venta no mezcla monedas).
  currency      Currency       @default(USD)
  paymentMethod PaymentMethod?

  createdById String?  // user que registró la venta
  soldAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       SaleItem[]
  // Ingreso que generó la venta en Finanzas (1 a 1).
  transaction Transaction?

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, soldAt])
  @@index([createdById])
}

// =====================================================================
// SALE ITEMS  (detalle: cada producto dentro de una venta)
// =====================================================================

model SaleItem {
  id     String @id @default(uuid())
  gymId  String
  saleId String

  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) // precio al momento de la venta
  subtotal  Decimal @db.Decimal(10, 2) // quantity * unitPrice

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([gymId])
  @@index([saleId])
  @@index([productId])
}

// =====================================================================
// PROGRESS / MEASUREMENTS
// =====================================================================

model Measurement {
  id       String @id @default(uuid())
  gymId    String
  memberId String

  weightKg Decimal? @db.Decimal(5, 2)
  heightCm Decimal? @db.Decimal(5, 2)
  bodyFat  Decimal? @db.Decimal(5, 2)

  chestCm Decimal? @db.Decimal(5, 2)
  waistCm Decimal? @db.Decimal(5, 2)
  armCm   Decimal? @db.Decimal(5, 2)

  notes String?
  date  DateTime @default(now())

  createdAt DateTime @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, memberId, date])
}


// =====================================================================
// STOCK MOVEMENTS
// =====================================================================
//
// Historial de cada ajuste de stock de un producto.
// Cada fila es inmutable: registra qué cambió, cuánto, el stock
// resultante, por qué y quién lo hizo. Nunca se edita ni se borra.
// =====================================================================

model StockMovement {
  id    String @id @default(uuid())
  gymId String

  productId String
  change    Int     // +entrada / -salida
  resultingStock Int // stock del producto DESPUÉS del movimiento
  reason    String?

  createdById String? // user que hizo el ajuste
  createdAt   DateTime @default(now())

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([productId])
  @@index([gymId, createdAt])
}


// =====================================================================
// GAMIFICATION — TIERS (niveles)
// =====================================================================
//
// Niveles configurables por gym, definidos por un umbral de puntos
// acumulados históricos (Member.lifetimePoints). Si un gym no define
// ninguno, el backend usa un set por defecto (Bronce/Plata/Oro/Platino).
// =====================================================================

model Tier {
  id    String @id @default(uuid())
  gymId String

  name      String
  minPoints Int
  color     String? // hex para la UI, ej. "#CD7F32"
  benefits  String?

  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, minPoints])
  @@index([gymId])
}

// =====================================================================
// GAMIFICATION — POINTS LEDGER
// =====================================================================
//
// Cada fila es inmutable: un movimiento de puntos (+ otorga / - deduce),
// el saldo resultante, su origen y quién lo hizo. Nunca se edita ni se
// borra (igual que StockMovement).
// =====================================================================

model PointsTransaction {
  id       String @id @default(uuid())
  gymId    String
  memberId String

  points       Int // +otorgado / -deducido
  balanceAfter Int // saldo del socio DESPUÉS del movimiento
  source       PointsSource
  reason       String?
  referenceId  String? // attendanceId, memberBadgeId, redemptionId…

  createdById String? // user que lo registró (null = automático)
  createdAt   DateTime @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, memberId, createdAt])
}

// =====================================================================
// GAMIFICATION — BADGES (insignias)
// =====================================================================

model Badge {
  id    String @id @default(uuid())
  gymId String

  name         String
  description  String?
  icon         String? // clave de ícono de la UI (flame, trophy, star…)
  criteria     BadgeCriteria @default(MANUAL)
  threshold    Int? // requerido salvo criteria MANUAL
  pointsReward Int           @default(0) // bono al desbloquearla
  active       Boolean       @default(true)

  createdAt DateTime @default(now())

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberBadges MemberBadge[]

  @@index([gymId])
}

// Insignia desbloqueada por un socio. `seenAt` null = el socio todavía no
// vio el pop-up de desbloqueo en el portal.
model MemberBadge {
  id       String @id @default(uuid())
  gymId    String
  memberId String
  badgeId  String

  awardedAt DateTime  @default(now())
  seenAt    DateTime?

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([memberId, badgeId])
  @@index([gymId])
  @@index([memberId, seenAt])
}

// =====================================================================
// GAMIFICATION — REWARDS (catálogo canjeable)
// =====================================================================

model Reward {
  id    String @id @default(uuid())
  gymId String

  name              String
  description       String?
  type              RewardType
  value             Decimal?   @db.Decimal(10, 2) // % o monto según type
  pointsCost        Int
  stock             Int? // null = ilimitado
  // Puntos acumulados mínimos (nivel) para poder canjearla. null = cualquiera.
  minLifetimePoints Int?
  validUntil        DateTime?
  active            Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([gymId])
  @@index([gymId, active])
}

// Canje de una recompensa por un socio. `code` es lo que el socio muestra
// en recepción para que el staff lo valide y lo marque como entregado.
model RewardRedemption {
  id       String @id @default(uuid())
  gymId    String
  memberId String
  rewardId String

  pointsSpent Int
  code        String
  status      RedemptionStatus @default(PENDING)

  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@unique([gymId, code])
  @@index([gymId])
  @@index([memberId])
  @@index([rewardId])
  @@index([gymId, status])
}


// =====================================================================
// COMMUNITY — ROUTINE LOGS
// =====================================================================
//
// Registro de "rutina completada" por el socio. Alimenta los retos de tipo
// ROUTINE_COMPLETIONS. Máximo una por rutina por día (validado en servicio).
//
// DB-07 (WorkoutSession): por ahora esta tabla ES la sesión de entrenamiento
// (quién, qué rutina, cuándo). Si se necesita registrar series reales (peso y
// repeticiones por ejercicio), agregar WorkoutSet { routineLogId,
// routineExerciseId, setNumber, reps, weightKg } colgando de aquí, en vez de
// una tabla de sesiones paralela.
// =====================================================================

model RoutineLog {
  id        String @id @default(uuid())
  gymId     String
  memberId  String
  routineId String

  completedAt DateTime @default(now())

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, memberId, completedAt])
  @@index([routineId])
}

// =====================================================================
// COMMUNITY — CHALLENGES (retos temporales)
// =====================================================================
//
// Reto con ventana [startsAt, endsAt). El progreso de cada participante se
// RECALCULA desde los datos fuente (asistencias / rutinas) dentro de esa
// ventana, así nunca se desincroniza. Al llegar a `goal` se marca
// completedAt (una sola vez) y se acreditan `pointsReward` puntos.
// =====================================================================

model Challenge {
  id    String @id @default(uuid())
  gymId String

  name            String
  description     String?
  metric          ChallengeMetric
  goal            Int
  startsAt        DateTime
  endsAt          DateTime
  pointsReward    Int             @default(0)
  maxParticipants Int?            // null = sin cupo
  active          Boolean         @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym          Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([gymId])
  @@index([gymId, active, startsAt, endsAt])
}

model ChallengeParticipant {
  id          String @id @default(uuid())
  gymId       String
  challengeId String
  memberId    String

  progress    Int       @default(0)
  completedAt DateTime? // primera vez que alcanzó la meta
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([challengeId, memberId])
  @@index([gymId])
  @@index([memberId])
  @@index([challengeId, progress])
}

// =====================================================================
// RETENTION — AUTOMATED MESSAGES (RET-B03)
// =====================================================================
//
// Mensaje configurado por el gym que el cron diario envía cuando se cumple
// su disparador. `body`/`subject` aceptan variables {{nombre}}, {{gimnasio}},
// {{dias_inactivo}}, {{ultima_visita}}, {{plan}}, {{vence}}.
// =====================================================================

model AutomatedMessage {
  id    String @id @default(uuid())
  gymId String

  name             String
  trigger          AutomationTrigger
  channel          MessageChannel    @default(EMAIL)
  // INACTIVITY: días sin asistir. MEMBERSHIP_EXPIRING: días antes del vencimiento.
  triggerDays      Int
  // No reenviar al mismo socio antes de N días (y, en inactividad, solo una
  // vez por racha: se vuelve a enviar si vino y volvió a faltar).
  cooldownDays     Int               @default(7)
  subject          String?
  body             String
  // WhatsApp solo permite iniciar conversación con plantillas aprobadas en Meta.
  whatsappTemplate String?
  active           Boolean           @default(true)
  lastRunAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  logs MessageLog[]

  @@index([gymId])
  @@index([gymId, active, trigger])
}

// =====================================================================
// RETENTION — MESSAGE LOG (RET-B01)
// =====================================================================
//
// Historial inmutable de cada envío (automático o de prueba). También es la
// base del anti-spam: el cron consulta aquí antes de reenviar.
// =====================================================================

model MessageLog {
  id                 String  @id @default(uuid())
  gymId              String
  memberId           String?
  automatedMessageId String?

  channel   MessageChannel
  trigger   AutomationTrigger?
  recipient String
  subject   String?
  body      String
  status    MessageStatus
  error     String?

  createdAt DateTime @default(now())

  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member           Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  automatedMessage AutomatedMessage? @relation(fields: [automatedMessageId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([automatedMessageId, memberId, createdAt])
}

// =====================================================================
// RETENTION — REFERRALS (RET-B04)
// =====================================================================
//
// Un socio (referrer) trae a otro (referred). Cada socio puede haber sido
// referido una sola vez. El premio se paga cuando el referido tiene su
// primera membresía (no al registrarse), para que no se pueda abusar.
// =====================================================================

model Referral {
  id         String @id @default(uuid())
  gymId      String
  referrerId String
  referredId String @unique
  code       String // código usado (snapshot)

  status         ReferralStatus @default(PENDING)
  referrerPoints Int            @default(0)
  referredPoints Int            @default(0)
  rewardedAt     DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  referrer Member @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Member @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, status])
  @@index([referrerId])
}

// =====================================================================
// DATA MIGRATION — IMPORT JOBS (MIG-B01)
// =====================================================================
//
// Historial de cada importación: quién, qué archivo y el resultado fila por
// fila (errores incluidos) para poder auditarla o descargar el reporte.
// =====================================================================

model ImportJob {
  id    String @id @default(uuid())
  gymId String

  type      ImportType
  fileName  String
  status    ImportStatus @default(RUNNING)
  totalRows Int          @default(0)
  processed Int          @default(0)
  created   Int          @default(0)
  updated   Int          @default(0)
  skipped   Int          @default(0)
  failed    Int          @default(0)
  // [{ row, status, message }] de las filas con error u omitidas.
  issues    Json?

  createdById String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, startedAt])
}

// =====================================================================
// TRAINING — EXERCISE CATALOG (DB-06)
// =====================================================================
//
// Catálogo de ejercicios del gym. Se alimenta solo: al guardar una rutina
// estructurada (p. ej. la que genera la IA) se reutiliza el ejercicio por
// nombre (sin distinguir mayúsculas) o se crea.
// =====================================================================

model Exercise {
  id    String @id @default(uuid())
  gymId String

  name        String
  muscleGroup String?
  equipment   String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]

  @@unique([gymId, name])
  @@index([gymId])
}

// Ejercicio dentro de una rutina: día, orden y prescripción.
model RoutineExercise {
  id         String @id @default(uuid())
  gymId      String
  routineId  String
  exerciseId String

  day         Int     // 1..7 (día de la rutina, no día de la semana)
  order       Int     // posición dentro del día
  sets        Int
  reps        String  // "10-12", "30s", "al fallo"…
  restSeconds Int?
  notes       String?

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // Restrict: no se puede borrar un ejercicio que está en uso.
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([routineId, day, order])
  @@index([exerciseId])
}
