// =====================================================================
// Prisma schema — FraguaGo (multi-tenant gym SaaS)
// =====================================================================
// Golden rule:
// Every business table has gymId.
// Tenant isolation is enforced by NestJS.
// Every query must be scoped by gymId.
//
// Architecture:
//   User    -> Authentication + authorization
//   Profile -> Personal information
//   Member  -> Gym customer / client
//   Trainer -> Trainer-specific information
// =====================================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  OWNER
  ADMIN
  TRAINER
  STAFF
  MEMBER
}

enum ConceptKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

// =====================================================================
// TENANT
// =====================================================================

model Gym {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  profiles     Profile[]
  members      Member[]
  plans        MembershipPlan[]
  memberships  Membership[]
  routines     Routine[]
  trainers     Trainer[]
  concepts     Concept[]
  transactions Transaction[]
  services     Service[]
  schedules    Schedule[]
  auditLogs    AuditLog[]
  attendances  Attendance[]
  products     Product[]
  sales        Sale[]
  measurements Measurement[]

  @@index([name])
}

// =====================================================================
// USERS
// =====================================================================
// Represents an account that can authenticate into FraguaGo.
//
// Examples:
//   OWNER   -> Gym owner
//   ADMIN   -> Administrator
//   TRAINER -> Trainer with system access
//   STAFF   -> Reception/staff
//   MEMBER  -> Gym customer with portal/app access
// =====================================================================

model User {
  id           String   @id @default(uuid())
  gymId        String
  email        String   @unique
  passwordHash String
  role         Role

  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  profile      Profile?
  member       Member?
  trainer      Trainer?
  auditLogs    AuditLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Email is unique inside a gym, not globally.
  @@unique([gymId, email])
  @@index([gymId])
}

// =====================================================================
// PROFILE
// =====================================================================
// Personal information belonging to a User.
//
// Authentication data stays in User.
// Personal data stays here.
// =====================================================================

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique

  firstName String
  lastName  String
  phone     String?
  avatarUrl String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  gymId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

// =====================================================================
// MEMBERS
// =====================================================================
// Gym customers.
//
// A Member has a User account because members can log in to:
//   - View membership
//   - View routines
//   - View attendance
//   - View measurements
//   - View progress
//
// userId is unique because one User can represent only one Member.
// =====================================================================

model Member {
  id            String   @id @default(uuid())
  gymId         String
  userId        String   @unique

  birthDate     DateTime?
  guardianName  String?
  guardianPhone String?
  status        String   @default("active")
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  gym           Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberships   Membership[]
  routines      Routine[]
  transactions  Transaction[]
  attendances   Attendance[]
  sales         Sale[]
  measurements  Measurement[]

  @@index([gymId])
  @@index([userId])
}

// =====================================================================
// MEMBERSHIP PLANS
// =====================================================================

model MembershipPlan {
  id           String   @id @default(uuid())
  gymId        String
  name         String
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int
  createdAt    DateTime @default(now())

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([gymId])
}

// =====================================================================
// MEMBERSHIPS
// =====================================================================

model Membership {
  id        String   @id @default(uuid())
  gymId     String
  memberId  String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   @default("active")
  createdAt DateTime @default(now())

  gym       Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan      MembershipPlan @relation(fields: [planId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([planId])
}

// =====================================================================
// TRAINERS
// =====================================================================
// Trainer-specific business information.
//
// Authentication data is stored in User.
// Personal data is stored in Profile.
// Trainer stores only information specific to being a trainer.
// =====================================================================

model Trainer {
  id        String   @id @default(uuid())
  gymId     String
  userId    String   @unique
  specialty String?
  createdAt DateTime @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  routines  Routine[]
  schedules Schedule[]

  @@index([gymId])
  @@index([userId])
}

// =====================================================================
// ROUTINES
// =====================================================================

model Routine {
  id          String   @id @default(uuid())
  gymId       String
  memberId    String
  trainerId   String?
  name        String
  description String?
  createdAt   DateTime @default(now())

  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([memberId])
  @@index([trainerId])
}

// =====================================================================
// CONCEPTS
// =====================================================================
// Financial categories.
// =====================================================================

model Concept {
  id        String      @id @default(uuid())
  gymId     String
  name      String
  kind      ConceptKind
  createdAt DateTime    @default(now())

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([gymId])
}

// =====================================================================
// FINANCIAL TRANSACTIONS
// =====================================================================

model Transaction {
  id        String          @id @default(uuid())
  gymId     String
  type      TransactionType
  conceptId String?
  memberId  String?
  amount    Decimal         @db.Decimal(10, 2)
  note      String?
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  concept   Concept?  @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([gymId, type])
  @@index([memberId])
}

// =====================================================================
// SERVICES
// =====================================================================

model Service {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

// =====================================================================
// SCHEDULES
// =====================================================================

model Schedule {
  id        String   @id @default(uuid())
  gymId     String
  trainerId String?
  title     String
  weekday   Int      // 0 = Sunday ... 6 = Saturday
  startTime String   // "18:00"
  endTime   String   // "19:00"
  capacity  Int?
  createdAt DateTime @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer   Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([trainerId])
}

// =====================================================================
// AUDIT LOGS
// =====================================================================

model AuditLog {
  id        String   @id @default(uuid())
  gymId     String
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([userId])
  @@index([gymId, createdAt])
}

// =====================================================================
// ATTENDANCE
// =====================================================================

model Attendance {
  id          String   @id @default(uuid())
  gymId       String
  memberId    String
  checkedInAt DateTime @default(now())

  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, checkedInAt])
}

// =====================================================================
// PRODUCTS & INVENTORY
// =====================================================================

model Product {
  id        String   @id @default(uuid())
  gymId     String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  sku       String?
  createdAt DateTime @default(now())

  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@index([gymId])
  @@index([gymId, sku])
}

// =====================================================================
// SALES / POS
// =====================================================================

model Sale {
  id        String   @id @default(uuid())
  gymId     String
  productId String
  memberId  String?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([productId])
  @@index([memberId])
  @@index([gymId, soldAt])
}

// =====================================================================
// PROGRESS / MEASUREMENTS
// =====================================================================

model Measurement {
  id        String   @id @default(uuid())
  gymId     String
  memberId  String

  weightKg  Decimal? @db.Decimal(5, 2)
  heightCm  Decimal? @db.Decimal(5, 2)
  bodyFat   Decimal? @db.Decimal(5, 2)
  chestCm   Decimal? @db.Decimal(5, 2)
  waistCm   Decimal? @db.Decimal(5, 2)
  armCm     Decimal? @db.Decimal(5, 2)

  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, memberId, date])
}
