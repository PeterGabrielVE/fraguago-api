# Servidor API
PORT=3001
JWT_SECRET="reemplazar_con_tu_secreto_jwt"

# Conexiones de Base de Datos para Docker
# Estructura: postgresql://[usuario]:[password]@postgres:5432/[base_de_datos]?schema=public
DATABASE_URL="postgresql://usuario:password@postgres:5432/mi_base_de_datos?schema=public"
AUTH_DATABASE_URL="postgresql://usuario_auth:password_auth@postgres:5432/mi_base_de_datos?schema=public"

# Credenciales de Inicialización del Contenedor Postgres
POSTGRES_USER=usuario_admin_aqui
POSTGRES_PASSWORD=password_admin_aqui
POSTGRES_DB=mi_base_de_datos

# Email (RET-B01) — SMTP de cualquier proveedor (Gmail, SES, Brevo, Mailtrap…).
# Sin SMTP_HOST los envíos quedan registrados como SKIPPED (no fallan).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FraguaGo <no-reply@tu-dominio.com>"

# WhatsApp Cloud API (opcional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=58

# Job diario de retención (RET-B02): 9:00 en esta zona horaria.
RETENTION_CRON_TZ=America/Caracas
RETENTION_CRON_ENABLED=true
